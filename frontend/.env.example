# TraceLens — local development environment
# Copy this file to .env and fill in the values.
#
# For local dev: point at your local backend (default FastAPI port)
VITE_API_BASE_URL=http://localhost:8000

# For production deployments: replace with your Railway / Render backend URL
# VITE_API_BASE_URL=https://tracelens-backend.up.railway.app

